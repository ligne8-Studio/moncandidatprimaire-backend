# Public project coordinates (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-to-server authentication for the Next.js API route -> Edge Function.
# Generate with `openssl rand -hex 32`; use the same value in the frontend
# server environment and as a Supabase Edge Function secret.
QUIZ_SUBMISSION_SHARED_SECRET=replace_with_a_random_64_character_hex_value

# Used only by the Edge Function to HMAC short-lived anti-abuse hashes.
QUIZ_HASH_SECRET=replace_with_a_different_random_64_character_hex_value

# Local CLI linking only. Never commit the real database password.
SUPABASE_DB_PASSWORD=replace_me
